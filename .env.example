# Copy to .env for local real logins. On a host, set these as environment variables.

PUBLIC_URL=http://localhost:5173
SESSION_SECRET=

# https://discord.com/developers/applications
# Local redirect:  http://localhost:5173/api/auth/discord/callback
# Live redirect:   https://YOUR-SITE/api/auth/discord/callback
# Scopes: identify
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# https://develop.battle.net/access/clients
# Local redirect:  http://localhost:5173/api/auth/battlenet/callback
# Live redirect:   https://YOUR-SITE/api/auth/battlenet/callback
# Scopes: openid wow.profile
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REGION=us

# After you sign in once, copy the ids from the Account page
LEAD_DISCORD_IDS=
LEAD_BATTLENET_IDS=

# 1 = always allow local Nyx/Officer logins, 0 = never
# Default: on locally when a provider is not configured; off in production
# AUTH_DEMO=

# Where signups and linked accounts are stored (default: ./data)
# DATA_DIR=
